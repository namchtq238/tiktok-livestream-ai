        "overlayImage": "./overlays/brand-2.png",
        "overlayPos": "20:20"
      }
    },
    {
      "url": "rtmp://127.0.0.1/fan3",
      "variant": {
        "resolution": "1280x720",
        "bitrate": "2000k",
        "crop": "iw*0.94:ih*0.94",
        "startOffsetSec": 6,
        "overlayImage": "./overlays/brand-3.png",
        "overlayPos": "20:20"
      }
    }
  ]
