{
  "_comment": "Phase 2 example config demonstrating the variant schema. Run with: node stream-fanout-runner.js --config stream-fanout-runner.example-variant.config.json. Overlay PNGs are 1x1 transparent placeholders until phase 6 replaces them with visible logos.",
  "ffmpegPath": "C:\\Users\\LENOVO\\Downloads\\ffmpeg-8.1-essentials_build\\ffmpeg-8.1-essentials_build\\bin\\ffmpeg.exe",
  "source": "rtmp://127.0.0.1/live/stream",
  "loopbackBase": "rtmp://127.0.0.1",
  "mode": "multi",
  "antiDuplicate": {
    "enabled": true,
    "preflightBenchmark": true,
    "maxStreams": 5
