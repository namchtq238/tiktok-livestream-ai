        "startOffsetSec": 0,
        "overlayImage": "./overlays/brand-1.png",
        "overlayPos": "20:20"
      }
    },
    {
      "url": "rtmp://127.0.0.1/fan2",
      "variant": {
        "resolution": "1600x900",
        "bitrate": "2500k",
        "crop": "iw*0.96:ih*0.96",
