{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["modules/**/*", "services/**/*", "tools/**/*", "test-playwright.ts", "test-scraper.ts", "test-modules.ts"],
  "exclude": ["node_modules", "dist"]
}
