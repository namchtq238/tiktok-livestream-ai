{
  "name": "tiktok-live-automation",
  "version": "1.0.0",
  "description": "TikTok Live Stream Automation with Stream Key Management",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "deepfake:run": "node scripts/deepfake-worker-runner.js --config scripts/deepfake-worker-runner.config.json",
    "deepfake:example": "node scripts/deepfake-worker-runner.js --config scripts/deepfake-worker-runner.example.config.json",
    "test": "vitest --run",
    "test:watch": "vitest"
  },
  "keywords": [
    "tiktok",
    "live",
    "automation",
    "stream"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^20.19.39",
    "@types/node-forge": "^1.3.14",
    "@vitest/ui": "^4.1.5",
    "fast-check": "^4.7.0",
    "node-forge": "^1.4.0",
    "selfsigned": "^5.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "playwright": "^1.59.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  }
}
